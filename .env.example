# -----------------------------
# OVERHAUL backend configuration
# -----------------------------

# Azure OpenAI (primary LDRAGo provider)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Maps (used for geocoding / reverse geocoding)
AZURE_MAPS_KEY=your_azure_maps_key

# Customer Validation moderation (optional admin endpoint)
VALIDATION_ADMIN_TOKEN=set_a_random_token_here

# Optional override: where to store the validation SQLite DB
# OVERHAUL_VALIDATION_DB_URL=sqlite+aiosqlite:////absolute/path/to/validation.db
