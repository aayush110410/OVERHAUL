# ─────────────────────────────────────────────────────────────────
# OVERHAUL — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Lines starting with # are optional / have defaults.

# ── LLM Providers ────────────────────────────────────────────────

# Qwen 3 4B via OpenRouter (primary fast LLM)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Model IDs (OpenRouter) — override defaults if needed
# QWEN_MODEL=qwen/qwen3-4b:free
# LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GPT_OSS_MODEL=openai/gpt-oss-120b:free

# Google Gemini (orchestrator + agents)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.1-pro-preview

# ── Map & Traffic APIs ───────────────────────────────────────────

# Geocoding: Nominatim / OSM (free, no key needed)
# Map tiles: CartoDB Dark (free, no key needed)

# TomTom Traffic Flow (optional — real-time speed data)
# Get your key at: https://developer.tomtom.com/
# TOMTOM_API_KEY=your_tomtom_api_key

# Mapbox (optional — used by landing page and flyover sim)
# Get your token at: https://account.mapbox.com/
# MAPBOX_TOKEN=your_mapbox_token

# ── Imagen Overlay (optional — AI-generated map overlays) ────────

# Separate key for Imagen 3 image generation
# IMAGEN_API_KEY=your_imagen_api_key

# ── Customer Validation ──────────────────────────────────────────

# Admin token for moderation endpoints
VALIDATION_ADMIN_TOKEN=set_a_random_token_here

# ── Database ─────────────────────────────────────────────────────

# Supabase (optional — falls back to local SQLite)
# Get your project URL/key at: https://supabase.com/dashboard
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# SQLite override path (optional)
# OVERHAUL_VALIDATION_DB_URL=sqlite+aiosqlite:////absolute/path/to/validation.db

# ── Feature Flags ────────────────────────────────────────────────

# Toggle subsystems on/off (1 = enabled, 0 = disabled)
# OVERHAUL_ENABLE_ENGINES=1
# OVERHAUL_ENABLE_RAG=1
# OVERHAUL_ENABLE_IMAGEN=1

# ── Microservices (local dev only) ───────────────────────────────
# Override service URLs when running services individually
# OVERHAUL_SIMULATION_URL=http://localhost:8001
# OVERHAUL_LLM_URL=http://localhost:8002
# OVERHAUL_DATA_URL=http://localhost:8003
# OVERHAUL_VALIDATION_URL=http://localhost:8004
# OVERHAUL_TRAFFIC_GOD_URL=http://localhost:8005
